# Names only. Copy to .env.dev (git-ignored) and fill in; never commit values.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
ALLOWED_EMAILS=
# For deploying the API from this machine (MANUAL-SETUP-STEPS.md 4b and 4c):
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Any long random string (openssl rand -base64 32). Keep it: CI needs the same one, and Alchemy encrypts its state with it.
ALCHEMY_PASSWORD=
