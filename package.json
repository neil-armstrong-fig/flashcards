{
  "name": "flashcards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "start": "pnpm --filter @flashcards/webapp start",
    "api:dev": "pnpm --filter @flashcards/api start",
    "start:local": "trap 'kill 0' INT TERM EXIT; pnpm --filter @flashcards/api start & pnpm --filter @flashcards/webapp start & wait",
    "start:deployed": "trap 'kill 0' INT TERM EXIT; pnpm --filter @flashcards/api start:deployed & pnpm --filter @flashcards/webapp start:deployed & wait",
    "provision:local": "pnpm --filter @flashcards/infra provision:local",
    "start:preview": "pnpm --filter @flashcards/webapp start:preview",
    "build": "pnpm --recursive build",
    "checks": "pnpm --recursive checks",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "pnpm --recursive format",
    "format:check": "pnpm --recursive format:check",
    "type-check": "pnpm --recursive type-check",
    "test": "pnpm --recursive test",
    "install-browsers": "pnpm --filter @flashcards/acceptance-tests install-browsers",
    "acceptance-tests": "pnpm --filter @flashcards/acceptance-tests acceptance-tests",
    "acceptance-tests:pwa": "pnpm --filter @flashcards/acceptance-tests acceptance-tests:pwa",
    "acceptance-tests:headed": "pnpm --filter @flashcards/acceptance-tests acceptance-tests:headed",
    "acceptance-tests:ui": "pnpm --filter @flashcards/acceptance-tests acceptance-tests:ui",
    "acceptance-tests:report": "pnpm --filter @flashcards/acceptance-tests acceptance-tests:report"
  }
}
