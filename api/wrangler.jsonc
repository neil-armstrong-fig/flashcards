{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flashcards-api",
  "main": "src/ApiWorker.ts",
  "compatibility_date": "2026-09-01",
  // For `wrangler dev` and the local database only. Production is declared in `infra/` and deployed by Alchemy, which keeps the same
  // names, bindings and limits: change them there too.
  // The local database needs no id: `pnpm --filter @language-learning/api db:migrate:local` makes it under .wrangler/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flashcards",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {"binding": "SPEECH_BUDGET", "id": "REPLACE_WITH_ID_FROM_wrangler_kv_namespace_create"},
    {"binding": "SPEECH_AUDIO", "id": "REPLACE_WITH_ID_FROM_wrangler_kv_namespace_create"},
  ],
  // The private bucket of recordings. Locally `wrangler dev` emulates it under .wrangler/; upload with `pnpm upload-audio` (tools).
  "r2_buckets": [{"binding": "RECORDINGS", "bucket_name": "flashcards-recordings"}],
  // Speech requests and sign-in attempts, by address. The numbers and namespace ids must match `infra/`.
  "ratelimits": [
    {"name": "SPEECH_LIMITER", "namespace_id": "2001", "simple": {"limit": 20, "period": 60}},
    {"name": "LOGIN_LIMITER", "namespace_id": "2002", "simple": {"limit": 10, "period": 60}},
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000",
    // The Google accounts that may sign in: this is a private test app. Put your own address here (or in .dev.vars).
    "ALLOWED_EMAILS": "REPLACE_WITH_YOUR_GOOGLE_EMAIL",
    "AZURE_SPEECH_REGION": "uksouth",
  },
  // Secrets, set with `wrangler secret put` (or in .dev.vars locally, see .dev.vars.example): AZURE_SPEECH_KEY, GOOGLE_OAUTH_CLIENT_ID,
  // GOOGLE_OAUTH_SECRET.
}
